        cocosdenshion_static  [style=filled, fillcolor=green]
        cocos_flatbuffers_static [style=filled, fillcolor=green]
        
    };
    cocos_ui_static -> cocos_extension_static [style=filled, fillcolor=green];
    cocosdenshion_static -> audioengine_static [style=filled, fillcolor=green];
    
    audioengine_static -> {
        libvorbisidec [style=filled, fillcolor=green]
        libpvmp3dec [style=filled, fillcolor=green]
        
    };
    
    spine_static -> cocos2dx_internal_static[style=filled, fillcolor=green];
    

  
    cocos_curl_static -> {
        cocos_crypto_static [style=filled, fillcolor=green]
        cocos_ssl_static[style=filled, fillcolor=green]
        
    };
    
	cocos_extension_static -> {
