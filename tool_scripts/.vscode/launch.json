{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Lua Debugger",
            "type": "LuaHelper-Debug",
            "request": "launch",
            "description": "通用模式,通常调试项目请选择此模式",
            "cwd": "${workspaceFolder}",
            "luaFileExtension": "",
            "connectionPort": 8818,
            "stopOnEntry": false,
            "useCHook": true,
            "autoPathMode": true,
            "program": "${workspaceFolder}/bin/lua.exe",
            "args": [
                "${file}",
                // "C:\\work\\BlackMoon\\BlackMoonAndroid\\engine",
                // "engine",
                // "temp\\commands_files1.txt"
            ],
        }
    ],
}